{
  "name": "kaiten-mcp-server",
  "version": "3.6.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/VadimOnix/kaiten-mcp-server.git"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "MCP server for Kaiten API integration with Claude - Production-ready with Token Economy (90% savings), Verbosity control, Response formats, Logging & Monitoring",
  "main": "dist/index.js",
  "bin": {
    "kaiten-mcp-server": "./dist/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "docker:build": "docker build -t mcp-kaiten .",
    "docker:run": "docker run --rm -i -e KAITEN_API_URL -e KAITEN_API_TOKEN -e KAITEN_DEFAULT_SPACE_ID -e KAITEN_INSECURE_SSL mcp-kaiten",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "kaiten",
    "mcp",
    "model context protocol",
    "api",
    "server",
    "project management"
  ],
  "author": "Vladimir Saraniuk",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.2.3",
    "lru-cache": "^11.0.2",
    "p-queue": "^9.0.0",
    "pino": "^10.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^24.7.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "semantic-release": "^25.0.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
